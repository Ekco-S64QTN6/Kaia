# Kaia Policy Gate.
#
# Paths below refer to the DEPLOYED tree (/opt/kaia), not a developer checkout.
# Install with: sudo scripts/install_services.sh
#
# The daemon runs as root because it manipulates nftables, restarts systemd
# units and binds raw sockets. Running it out of a user-writable checkout would
# therefore mean root executing code any unprivileged process could rewrite, so
# install_services.sh deploys a root-owned copy and this unit points at that.

[Unit]
Description=Kaia Out-of-Process Policy Gate Daemon
After=network.target postgresql.service kaia-restore-blocks.service
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=__DEPLOY_DIR__
Environment=KAIA_PROJECT_DIR=__DEPLOY_DIR__
Environment=KAIA_STATE_DIR=__STATE_DIR__
Environment=PYTHONPATH=__DEPLOY_DIR__:__DEPLOY_DIR__/core
# Signing secret, root-owned 0600. Never inline it here: an earlier version set
# Environment=KAIA_CAPABILITY_TOKEN_SECRET=... in this tracked file, which put
# the live capability-token signing key into public git history.
EnvironmentFile=/etc/kaia/secret.env
ExecStart=/usr/bin/python3 __DEPLOY_DIR__/security/policy_gate.py
Restart=always
RestartSec=1
RuntimeDirectory=kaiacord

User=root
Group=kaiacord

# CAP_DAC_OVERRIDE dropped: it bypasses ALL file permission checks, and was only
# needed because the daemon read a 0600 .env owned by an unprivileged user. The
# secret now arrives via EnvironmentFile from root-owned /etc/kaia/secret.env.
#
# CAP_SYS_ADMIN is omitted by default under least privilege. fanotify and BCC/eBPF
# availability depends on the deployed kernel, capabilities and installed bindings;
# do not infer live-host support from source code or an old setup report. Probe the
# deployed tree with `sudo python3 scripts/fanotify_probe.py /opt/kaia`, verify BCC
# separately, then add CAP_SYS_ADMIN to BOTH lines only if the controls need it.
# CAP_BPF + CAP_PERFMON load the eBPF telemetry/honeypot probes (kernel >= 5.8).
# They are far narrower than CAP_SYS_ADMIN, which stays a separate decision for
# fanotify FIM (docs/DEPLOYMENT_CHECKLIST.md step 1). Without them every probe,
# including honeypot file watching, failed to load and nothing was detected.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_BPF CAP_PERFMON
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_BPF CAP_PERFMON

NoNewPrivileges=true
ProtectSystem=strict
# Home directories are an empty tmpfs; only the canary flag files below are
# bound in, read-only, so the honeypot can watch them by inode.
ProtectHome=tmpfs
BindReadOnlyPaths=-__OWNER_HOME__/flag.txt -/root/root.txt
Environment=KAIA_CANARY_PATHS=__OWNER_HOME__/flag.txt:/root/root.txt
PrivateDevices=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# __STATE_DIR__ holds the audit ledger, event DB and trusted baseline (INV-008:
# outside the agent's working tree). The installer substitutes the configured path;
# the deployed code tree itself stays read-only to the daemon.
ReadWritePaths=/run/kaiacord __STATE_DIR__ __DEPLOY_DIR__/logs
ReadWritePaths=-/etc/api_keys.json -/var/backups/credentials.txt -/root/.ssh

[Install]
WantedBy=multi-user.target
