# IMPORTANT: Set KAIA_PROJECT_DIR to the absolute path of your Kaia repo.
# Edit the paths below before running: sudo scripts/install_services.sh
[Unit]
Description=Kaia Out-of-Process Policy Gate Daemon
After=network.target postgresql.service
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
Environment=KAIA_PROJECT_DIR=/home/ekco/github/Kaia
Environment=PYTHONPATH=/home/ekco/github/Kaia/core:/home/ekco/github/Kaia
Environment=KAIA_CAPABILITY_TOKEN_SECRET=kaia_secure_signing_secret_key_2026
ExecStart=/home/ekco/github/Kaia/.venv/bin/python /home/ekco/github/Kaia/security/policy_gate.py
WorkingDirectory=/home/ekco/github/Kaia
Restart=always
RestartSec=1
RuntimeDirectory=kaiacord
User=root
Group=kaiacord
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_DAC_OVERRIDE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=true
PrivateTmp=true
ReadOnlyPaths=/home/ekco/github/Kaia
ReadWritePaths=/run/kaiacord /home/ekco/github/Kaia/storage /home/ekco/github/Kaia/logs /var/lib/secdaemon -/etc/api_keys.json -/var/backups/credentials.txt -/root/.ssh

[Install]
WantedBy=multi-user.target
