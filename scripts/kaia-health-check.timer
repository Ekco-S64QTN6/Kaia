[Unit]
Description=Kaia: check the security controls every 5 minutes

[Timer]
# OnActiveSec, not OnBootSec: enabling the timer long after boot (the installer
# does) made an elapsed OnBootSec fire at once, before the gate was started.
OnActiveSec=5min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
